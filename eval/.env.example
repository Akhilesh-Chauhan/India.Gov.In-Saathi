# Copy to eval/.env and fill in. Never share or commit eval/.env.

# --- Judge: Claude on Amazon Bedrock (credentials via env vars below OR an `aws configure` profile)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary credentials
# AWS_PROFILE=negd            # instead of the two keys above
JUDGE_MODEL=global.anthropic.claude-opus-5-5
JUDGE_EFFORT=high
JUDGE_FALLBACK_MODEL=global.anthropic.claude-opus-5   # used only if the judge model declines; leave empty to disable

# --- Bot under test (the curl command goes in eval/bot_curl.txt)
# BOT_ANSWER_PATH=data.answer   # dotted path to the answer text, if auto-detection picks the wrong field
# BOT_SOURCES_PATH=data.sources # dotted path to the source list
BOT_TIMEOUT=60
# BOT_INSECURE_TLS=1            # only if the staging URL has a self-signed certificate

# PAGE_CACHE_HOURS=12           # how long fetched official pages are reused
